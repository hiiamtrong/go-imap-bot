# OAuth Configuration - IMPORTANT: Set these up before deployment

# Get these from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# 1. Create a new OAuth 2.0 Client ID
# 2. Add authorized redirect URIs:
#    - http://localhost:5173/auth/callback (for development)
#    - https://your-domain.com/auth/callback (for production)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Redirect URL - must match one of the authorized redirect URIs in Google Console
GOOGLE_REDIRECT_URL=http://localhost:5173/auth/callback

# JWT Secret - IMPORTANT: Change this to a random secure string in production
# Generate one with: openssl rand -base64 32
JWT_SECRET=your-secret-jwt-key-change-this-in-production

# Frontend API URL
VITE_API_URL=http://localhost:8080
